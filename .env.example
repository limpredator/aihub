# Kamailio SIP proxy (same one softhone/CRM already use). This gateway
# registers over plain SIP/TLS like the native Linphone clients (not WSS —
# that path implies WebRTC media, which we're deliberately avoiding).
SIP_PROXY_HOST=pbx.cerdik.co
SIP_PROXY_TLS_PORT=5061
SIP_EXTENSION=
SIP_PASSWORD=

# Ring group membership on the office CD-series PBX
RING_GROUP_EXTENSIONS=

# Fallback extension(s) the ring group falls through to on no-answer/REFER
FALLBACK_EXTENSIONS=

# Speechmatics (realtime STT — confirm melia-1 is available on the realtime endpoint before relying on this)
SPEECHMATICS_API_KEY=

# OpenRouter (LLM conversational layer)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5-5

# TTS vendor: ElevenLabs (eleven_multilingual_v2 — Malay supported, covers
# the Bahasa Malaysia gap in docs/research-ai-receptionist.md). Get the key
# from elevenlabs.io -> profile -> API Keys. TTS_VOICE_ID is optional
# (defaults to the "Rachel" premade voice); pick another from the
# ElevenLabs Voice Library if you want a different accent/gender.
TTS_PROVIDER=elevenlabs
TTS_API_KEY=
TTS_VOICE_ID=

# Health check: how often to verify STT/LLM/TTS reachability before registering/staying registered
HEALTH_CHECK_INTERVAL_MS=15000
